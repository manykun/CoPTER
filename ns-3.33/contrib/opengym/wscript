# -*- Mode: python; py-indent-offset: 4; indent-tabs-mode: nil; coding: utf-8; -*-

import os
import shutil
import subprocess

def configure(conf):
    conf.env['ENABLE_ZMQ'] = conf.check(mandatory=False, lib='zmq', define_name='HAVE_ZMQ', uselib_store='ZMQ')
    # Use pkg-config's include AND library paths. A generic -lprotobuf check
    # can pair /usr/local headers with an older system library cached by Waf.
    conf.check_cfg(package='protobuf', args=['--cflags', '--libs'],
                   uselib_store='PROTOBUF', mandatory=True)
    pkg_config = os.environ.get('PKG_CONFIG', 'pkg-config')
    protoc = os.environ.get('PROTOC') or shutil.which('protoc')
    if not protoc:
        conf.fatal('protoc is missing; select the compiler matching pkg-config protobuf')
    try:
        compiler_version = subprocess.check_output([protoc, '--version']).decode().strip().split()[-1]
        library_version = subprocess.check_output([pkg_config, '--modversion', 'protobuf']).decode().strip()
        include_dir = subprocess.check_output([pkg_config, '--variable=includedir', 'protobuf']).decode().strip()
        lib_dir = subprocess.check_output([pkg_config, '--variable=libdir', 'protobuf']).decode().strip()
        numeric_version = tuple(int(part) for part in compiler_version.split('.'))
    except (OSError, ValueError, subprocess.CalledProcessError) as exc:
        conf.fatal('Cannot inspect the Protobuf toolchain: %s' % exc)
    if compiler_version != library_version or len(numeric_version) != 3 or numeric_version < (3, 0, 0):
        conf.fatal('Protobuf mismatch: protoc %s (%s), pkg-config library %s. Select one matching toolchain with PROTOC and PKG_CONFIG_PATH.' % (compiler_version, protoc, library_version))
    if not os.path.isdir(include_dir) or not os.path.isdir(lib_dir):
        conf.fatal('pkg-config protobuf returned missing include/library directories')
    conf.msg('Protobuf compiler', '%s (%s)' % (protoc, compiler_version))
    conf.msg('Protobuf headers', include_dir)
    conf.msg('Protobuf libraries', lib_dir)
    # Promote the selected installation ahead of inherited library paths. RPATH
    # also makes dependent ns-3 programs resolve this library at runtime.
    for key, values in (('INCLUDES', [include_dir]), ('LIBPATH', [lib_dir]), ('RPATH', [lib_dir])):
        conf.env[key] = values + [value for value in conf.env[key] if value not in values]
    conf.env.append_unique('LIB', ['zmq', 'protobuf'])
    conf.env['RPATH_PROTOBUF'] = [lib_dir]
    expected_version = numeric_version[0] * 1000000 + numeric_version[1] * 1000 + numeric_version[2]
    conf.check_cxx(
        fragment='''#include <google/protobuf/stubs/common.h>
static_assert(GOOGLE_PROTOBUF_VERSION == %d, "Protobuf header/protoc mismatch");
int main() { GOOGLE_PROTOBUF_VERIFY_VERSION; return 0; }
''' % expected_version,
        uselib='PROTOBUF', execute=True, mandatory=True,
        msg='Checking Protobuf compiler/header/linked runtime agreement')
    conf.env['ENABLE_PROTOBUF'] = True
    conf.env['ENABLE_PROTOC'] = True
    conf.env['PROTOC'] = [protoc]
    if not conf.env['ENABLE_ZMQ']:
        conf.fatal('OpenGym requires ZeroMQ')

    # Regenerate both bindings with the selected compiler, without a shell.
    try:
        pbSrcDir = os.path.join(conf.path.abspath(), 'model')
        for flag, destination in (('--cpp_out', pbSrcDir), ('--python_out', os.path.join(pbSrcDir, 'ns3gym', 'ns3gym'))):
            subprocess.check_call([protoc, '-I=' + pbSrcDir, '-I=' + include_dir,
                                   flag + '=' + destination, os.path.join(pbSrcDir, 'messages.proto')])
        conf.msg('Build ns3gym Protobuf messages', 'Done')
    except (OSError, subprocess.CalledProcessError) as exc:
        conf.fatal('Build of ns3gym Protobuf messages failed: %s' % exc)
    conf.check_cxx(
        fragment='''#include "messages.pb.cc"
int main() {
    ns3opengym::EnvStateMsg msg;
    msg.set_info("protobuf-link-probe");
    return msg.info() == "protobuf-link-probe" ? 0 : 1;
}
''', includes=[pbSrcDir], uselib='PROTOBUF', execute=True, mandatory=True,
        msg='Checking generated OpenGym messages compile, link and run')

def build(bld):
    # Don't do anything for this module if click should not be built.
    if 'opengym' in bld.env['MODULES_NOT_BUILT']:
        return

    module = bld.create_ns3_module('opengym', ['core'])
    module.source = [
        'model/opengym_interface.cc',
        'model/messages.pb.cc',
        'model/container.cc',
        'model/spaces.cc',
        'model/opengym_env.cc',
        'helper/opengym-helper.cc',
        ]

    module_test = bld.create_ns3_module_test_library('opengym')
    module_test.source = [
        'test/opengym-test-suite.cc',
        ]

    headers = bld(features='ns3header')
    headers.module = 'opengym'
    headers.source = [
        'model/opengym_interface.h',
        'model/messages.pb.h',
        'model/container.h',
        'model/spaces.h',
        'model/opengym_env.h',
        'helper/opengym-helper.h',
        ]

    module.uselib = ['ZMQ', 'PROTOBUF']

    if bld.env.ENABLE_EXAMPLES:
        bld.recurse('examples')

