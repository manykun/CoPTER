ENABLE_COPTER 1
ENABLE_MONITOR 1
ENABLE_QCN 1
USE_DYNAMIC_PFC_THRESHOLD 1

PACKET_PAYLOAD_SIZE 1000

TOPOLOGY_FILE mix/256hosts.topo
FLOW_FILE mix/acc_validation/@SCENARIO@_seed@SEED@.flow
TRACE_FILE mix/default.trace
TRACE_OUTPUT_FILE output/acc_validation/@SCENARIO@_seed@SEED@.tr
FCT_OUTPUT_FILE output/acc_validation/@SCENARIO@_seed@SEED@.fct
PFC_OUTPUT_FILE output/acc_validation/@SCENARIO@_seed@SEED@.pfc
QLEN_MONITOR_FILE output/acc_validation/@SCENARIO@_seed@SEED@.queue
RATE_MONITOR_FILE output/acc_validation/@SCENARIO@_seed@SEED@.rate
THROUGHPUT_OUTPUT_FILE output/acc_validation/@SCENARIO@_seed@SEED@.throughput

SIMULATOR_STOP_TIME 4.00

CC_MODE 1
ALPHA_RESUME_INTERVAL 1
RATE_DECREASE_INTERVAL 4
CLAMP_TARGET_RATE 0
RP_TIMER 300
EWMA_GAIN 0.00390625
FAST_RECOVERY_TIMES 1
RATE_AI 20Mb/s
RATE_HAI 200Mb/s
MIN_RATE 1000Mb/s
DCTCP_RATE_AI 1000Mb/s

ERROR_RATE_PER_LINK 0.0000
L2_CHUNK_SIZE 4000
L2_ACK_INTERVAL 1
L2_BACK_TO_ZERO 0

HAS_WIN 1
GLOBAL_T 1
VAR_WIN 1
FAST_REACT 0
U_TARGET 0.95
MI_THRESH 0
INT_MULTI 1
MULTI_RATE 0
SAMPLE_FEEDBACK 0
PINT_LOG_BASE 1.01
PINT_PROB 1.0
RATE_BOUND 1
ACK_HIGH_PRIO 0
LINK_DOWN 0 0 0
ENABLE_TRACE 0

KMAX_MAP 2 10000000000 32 40000000000 128
KMIN_MAP 2 10000000000 16 40000000000 64
PMAX_MAP 2 10000000000 0.20 40000000000 0.20
BUFFER_SIZE @BUFFER_KB@

OPENGYM_MIN_KMIN @KMIN_MIN@
OPENGYM_MAX_KMIN @KMIN_MAX@
OPENGYM_MIN_KMAX @KMAX_MIN@
OPENGYM_MAX_KMAX @KMAX_MAX@

QLEN_MON_FILE output/acc_validation/@SCENARIO@_seed@SEED@.qlen
QLEN_MON_START 1900000000
QLEN_MON_END 3200000000
